OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-6-luna
LOGIN_USERNAME=admin
LOGIN_PASSWORD=change_this_password
SECRET_KEY=change_this_to_a_long_random_string
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=oi_analyzer
FRONTEND_ORIGIN=http://localhost:8080
PORT=10000

# Zerodha Kite Connect
# Keep these only on the backend. Do not put them in frontend/.env.
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Optional daily token fallback. Prefer /api/kite/login instead.
KITE_ACCESS_TOKEN=
KITE_SESSION_FILE=.kite_session.json
KITE_ENABLE_WEBSOCKET=false
KITE_VALIDATE_ON_STARTUP=true
LIVE_OPTIONS_STRIKES_EACH_SIDE=8
LIVE_OPTIONS_SNAPSHOT_SECONDS=180
KITE_REQUEST_TIMEOUT=8
